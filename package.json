{
  "name": "citspark",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "license-check": "node --experimental-strip-types --no-warnings tools/license-check/cli.ts",
    "audit-gate": "node --experimental-strip-types --no-warnings tools/audit-gate/cli.ts",
    "live-kit:setup": "node --experimental-strip-types --no-warnings apps/extension/scripts/live-kit/cli.ts setup",
    "live-kit:launch": "node --experimental-strip-types --no-warnings apps/extension/scripts/live-kit/cli.ts launch",
    "live-kit:desktop": "node --experimental-strip-types --no-warnings apps/extension/scripts/live-kit/cli.ts desktop",
    "live-kit:evidence": "node --experimental-strip-types --no-warnings apps/extension/scripts/live-kit/cli.ts evidence",
    "live-kit:teardown": "node --experimental-strip-types --no-warnings apps/extension/scripts/live-kit/cli.ts teardown"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.46.4",
    "vitest": "^4.0.0"
  }
}
